# ==============================================================================
# i3wm Core Configuration - Tailored Minimalist Setup for TKL Keyboard
# ==============================================================================

# sudo pacman -S kitty rofi i3status dunst xorg-xset blueman xclip maim mpv nsxiv yazi micro
# paru -S throne-bin
# i3flow: git clone https://github.com/piadi-su/i3flow.git && cd i3flow && sudo make install

# Auto-tiling для более приятной раскладки окон
exec_always --no-startup-id i3flow

# Dual monitor layout
exec_always --no-startup-id xrandr \
    --output DP-0 \
        --primary \
        --mode 2560x1440 \
        --rate 260 \
        --pos 0x1080 \
        --rotate normal \
    --output HDMI-0 \
        --mode 1920x1080 \
        --rate 100 \
        --pos 320x0 \
        --rotate inverted

# Отключить погас экрана
exec_always --no-startup-id xset s off -dpms
exec_always --no-startup-id xset s noblank

# Автозапуск Bluetooth
exec --no-startup-id "blueman-applet > ~/.blueman.log 2>&1 &"

# Автозапуск Throne (его "Start with system" не работает — i3 не обрабатывает
# ~/.config/autostart/*.desktop, только явный exec ниже)
exec --no-startup-id throne

# Автоблокировка экрана перед suspend/сном (logind hook)
exec --no-startup-id xss-lock -- i3lock -c 0a0a0a

# Установка клавиши Mod (Mod4 = Клавиша Windows/Super)
set $mod Mod4

# Шрифт для заголовков окон (строгий, читаемый, без лишних засечек)
font pango:JetBrains Mono 10

# Использовать мышь с зажатым Mod для перетаскивания плавающих окон
floating_modifier $mod

# Раскладка us, ru на alt+shift
exec_after_restart --no-startup-id setxkbmap -layout us,ru -option grp:alt_shift_toggle

# Music notify
exec --no-startup-id ~/.local/bin/music-notify
exec --no-startup-id dunst

# Снижение задержки репита клавиш (в том числе на Backspace)
exec --no-startup-id xset r rate 200 40

# ==============================================================================
# 1. Запуск основных приложений
# ==============================================================================

# Терминал по умолчанию (Kitty - высокая производительность на GPU, инлайн-превью в Yazi)
bindcode $mod+36 exec kitty

# Быстрый запуск меню приложений (Rofi)
bindsym $mod+d exec --no-startup-id rofi -show drun

# Файловый менеджер (Yazi в терминале)
bindsym $mod+Shift+f exec --no-startup-id kitty -e yazi

# Просмотрщик изображений (nsxiv)
bindsym $mod+t exec --no-startup-id nsxiv ~/Pictures

# Снимок всего экрана (PrtSc)
bindsym Print exec --no-startup-id maim --format=png ~/Pictures/screenshot-$(date +%Y-%m-%d-%H%M%S).png

# Выделение области + сохранение (Shift + PrtSc)
bindsym Shift+Print exec --no-startup-id maim -s --format=png ~/Pictures/screenshot-$(date +%Y-%m-%d-%H%M%S).png

# Выделение области + сразу в буфер обмена (Ctrl + Shift + PrtSc) — очень удобно
bindsym Ctrl+Shift+Print exec --no-startup-id maim -s | xclip -selection clipboard -t image/png

# Активное окно
bindsym $mod+Print exec --no-startup-id maim --window $(xdotool getactivewindow) ~/Pictures/screenshot-$(date +%Y-%m-%d-%H%M%S).png

# Убийство фокуса (закрыть текущее окно)
bindsym $mod+Shift+q kill

# Ручная блокировка экрана
bindsym $mod+Shift+x exec --no-startup-id i3lock -c 0a0a0a

# ==============================================================================
# 2. Навигация и перемещение окон (Адаптировано под TKL стрелки и HJKL)
# ==============================================================================

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Ctrl+Up focus output up
bindsym $mod+Ctrl+Down focus output down

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Ctrl+Shift+Up move container to output up
bindsym $mod+Ctrl+Shift+Down move container to output down

# ==============================================================================
# 3. Управление разметкой (Layouts)
# ==============================================================================

bindsym $mod+b split h
bindsym $mod+v split v

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+f fullscreen toggle

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

bindsym $mod+a focus parent
# bindsym $mod+c focus child # Раскомментировать при необходимости глубокой вложенности

# ==============================================================================
# 4. Рабочие пространства (Workspaces)
# ==============================================================================

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6

# TCL — основной рабочий монитор
workspace 1 output DP-0
workspace 2 output DP-0
workspace 3 output DP-0
workspace 4 output DP-0
workspace 5 output DP-0

# Hisense — второй монитор
workspace 6 output HDMI-0

# ==============================================================================
# 5. Управление мультимедиа и системными функциями
# ==============================================================================

bindsym XF86AudioLowerVolume exec --no-startup-id ~/dotfiles/i3/.config/i3/scripts/volume.sh down
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/dotfiles/i3/.config/i3/scripts/volume.sh up
bindsym XF86AudioMute        exec --no-startup-id ~/dotfiles/i3/.config/i3/scripts/volume.sh  mute

bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next

bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-

# ==============================================================================
# 6. Системные команды i3wm
# ==============================================================================

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Do you really want to exit i3?' -B 'Yes, exit session' 'i3-msg exit'"

# ==============================================================================
# 7. Режим изменения размера окон (Resize Mode)
# ==============================================================================

mode "resize" {
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# ==============================================================================
# 8. Эстетика: Строгая монохромная палитра окон (Minimal Dark)
# ==============================================================================

client.focused          #222222  #1a1a1a  #ffffff  #444444   #292929
client.focused_inactive #151515  #151515  #888888  #151515   #151515
client.unfocused        #101010  #101010  #555555  #101010   #101010
client.urgent           #331111  #331111  #ffffff  #331111   #331111
client.placeholder      #000000  #0c0c0c  #ffffff  #000000   #0c0c0c

client.background       #0a0a0a

# ==============================================================================
# 9. Системный статус-бар
# ==============================================================================

bar {
	font pango:Noto Sans,Font Awesome 7 Free 10
    status_command i3status-rs ~/.config/i3status-rust/config.toml
    position bottom

    colors {
        background #101010
        statusline #ffffff
        separator #333333

        focused_workspace  #222222 #1a1a1a #ffffff
        active_workspace   #151515 #151515 #888888
        inactive_workspace #101010 #101010 #555555
        urgent_workspace   #331111 #331111 #ffffff
    }
}
